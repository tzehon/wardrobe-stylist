// Copy this file to `Secrets.xcconfig` (which is gitignored) and paste in your two
// values from the Google Cloud OAuth iOS client you created (docs/google-setup.md §4).
//
//   cp ios/Secrets.xcconfig.example ios/Secrets.xcconfig
//   # then edit ios/Secrets.xcconfig
//
// CFBundleURLTypes (Info.plist) reads $(GOOGLE_REVERSED_CLIENT_ID) for the OAuth callback
// URL scheme. GoogleSignIn-iOS reads GIDClientID (= $(GOOGLE_CLIENT_ID)) from Info.plist
// to configure itself at launch.

GOOGLE_CLIENT_ID = 123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.123456789012-abcdefghijklmnopqrstuvwxyz

// Backend URL is split into SCHEME + HOST because xcconfig can't put `//` inside a value
// (the rest of the line would be treated as a comment). Info.plist composes them at build
// time as `$(BACKEND_SCHEME)://$(BACKEND_HOST)`.
//
//   Local dev (simulator):  BACKEND_SCHEME = http    BACKEND_HOST = localhost:8000
//   Local dev (iPhone):     BACKEND_SCHEME = http    BACKEND_HOST = <Mac-LAN-IP>:8000
//   Production (Fly.io):    BACKEND_SCHEME = https   BACKEND_HOST = your-app.fly.dev
BACKEND_SCHEME = http
BACKEND_HOST = localhost:8000

// Public distribution requires real HTTPS pages on a stable domain. These values are
// deliberately invalid placeholders: a device Release archive fails until they are replaced.
PRIVACY_POLICY_URL = https:/$()/your-domain.example/privacy
SUPPORT_URL = https:/$()/your-domain.example/support

// Signed distribution settings belong in Distribution.xcconfig, not this Debug file.
