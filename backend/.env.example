# Copy to backend/.env (gitignored) and fill in. Only needed to actually call Claude.

# Anthropic API key — held ONLY here, never in the iOS app.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Development-only compatibility token. Never place it in a public Release app.
# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKEN=replace-with-a-long-random-string

# This legacy mode is backend-only curl/test compatibility. The iOS simulator
# stays local/demo-only because App Attest is unavailable there; connected-app
# development uses app_attest with a physical development-signed device.
# Production uses app_attest; bridge is temporary and requires a UTC
# LEGACY_BRIDGE_EXPIRES_AT no more than seven days away.
AUTH_MODE=legacy

# Required when AUTH_MODE is bridge or app_attest. Use a dedicated private
# directory locally. Production is pinned to the Fly volume at /data.
APP_ATTEST_APP_ID_PREFIX=
APP_ATTEST_BUNDLE_ID=com.tth.Wardrobe
APP_ATTEST_ENVIRONMENT=development
APP_ATTEST_DATABASE_PATH=/tmp/wardrobe-auth/auth.sqlite3
APP_ATTEST_SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_ATTEST_ALLOWED_VALIDATION_CATEGORIES=3
APP_ATTEST_ALLOWED_BUNDLE_VERSIONS=replace-with-current-CFBundleVersion
# LEGACY_BRIDGE_EXPIRES_AT=2026-08-20T00:00:00Z

# dev | development | test | production
ENVIRONMENT=dev
